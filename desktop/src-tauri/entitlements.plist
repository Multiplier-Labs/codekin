<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled Node runs V8's JIT under the hardened runtime (desktop plan, Distribution). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native addons (better-sqlite3) are signed separately from Node: npm prebuilds by their
       publisher, or ad-hoc. Library validation refuses both (an ad-hoc signature has no Team ID
       to match), so the server can't open SQLite. The official Node binary carries this too. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
