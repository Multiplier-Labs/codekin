{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codekin",
  "version": "../../package.json",
  "identifier": "ai.codekin.desktop",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "npm run bundle-server"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "Multiplier Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../build/codekin/": "codekin/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codekin"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2OUFDMkVENDdFMUI2OTEKUldTUnR1Rkg3Y0thaHVNRWttRWFYYUpjY2xoMmN3K0VoeExTK0dhaFhjSDVWNG90aVdwOHhsUUEK",
      "endpoints": [
        "https://github.com/Multiplier-Labs/codekin/releases/download/desktop-channel/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
